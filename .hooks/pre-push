#!/usr/bin/env bash
# Pre-push hook: run tests and type checking before pushing

set -e

if [ ! -d "node_modules" ]; then
  echo "[Hooks] ВНИМАНИЕ: node_modules не найден. Пропуск тестов перед push. Запустите 'npm install'."
  exit 0
fi

echo "[Hooks] Running tests..."
# Only run if the script exists in package.json
if grep -q '"test":' package.json; then
  npm test || { echo "Tests failed"; exit 1; }
else
  echo "[Hooks] 'test' script not defined in package.json. Skipping."
fi

echo "[Hooks] Running TypeScript type check..."
if grep -q '"type-check":' package.json; then
  npm run type-check || { echo "Type check failed"; exit 1; }
else
  echo "[Hooks] 'type-check' script not defined in package.json. Skipping."
fi

echo "[Hooks] Pre-push checks passed."
